# Database (Turso libSQL in prod; local SQLite in dev)
# Prod example: DATABASE_URL="libsql://your-db.turso.io"
# Dev: leave the file:./dev.db default below
DATABASE_URL="file:./dev.db"

# Required ONLY for Turso (libSQL remote). Leave empty in dev.
DATABASE_AUTH_TOKEN=""

# Vercel Blob token. When present, image/sound uploads go to Vercel Blob.
# When empty, they fall back to public/ filesystem (dev mode).
BLOB_READ_WRITE_TOKEN=""
